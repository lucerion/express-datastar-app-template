<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Express + Datastar app template</title>
    <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@1.0.0-RC.8/bundles/datastar.js"></script>
</head>
<body>
    <input
        type="text"
        placeholder="Enter name..."
        data-bind="name"
        data-on:input="@post('/greeting')"
    >
    <div id="greeting"></div>
</body>
</html>
